# Variables du client mobile. Préfixées EXPO_PUBLIC_, elles sont embarquées
# dans l'application et donc lisibles par quiconque l'installe : aucune ne doit
# porter de secret. Les secrets (base, jetons, chiffrement, SMTP, Google Places)
# appartiennent à l'API et se configurent dans le dépôt MyTripCircle-API.

# ─── Google OAuth (Client IDs — préfixe EXPO_PUBLIC_ requis pour accès côté client) ──
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ─── Développement local ──────────────────────────────────────────────────────
# Tenue à jour par `npm run dev` (scripts/update-ip.js) : IP locale du poste.
API_IP_PRIMARY=192.168.x.x
